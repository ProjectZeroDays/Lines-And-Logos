{
  "name": "lines-and-logos-desktop",
  "version": "1.0.0",
  "description": "Lines & Logos Business OS — desktop app (Windows/macOS). Opens on the login page; connects to a remote server or runs the bundled standalone server.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win --x64",
    "dist:mac": "electron-builder --mac --x64",
    "dist:linux": "electron-builder --linux"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.linesandlogos.businessos",
    "productName": "Lines & Logos Business OS",
    "directories": { "output": "dist" },
    "files": [ "main.js", "package.json" ],
    "extraResources": [
      {
        "from": "..",
        "to": "app",
        "filter": [
          "server.js", "package.json", "*.html", "*.png",
          "assets/**", "lib/**", "icons/**", ".well-known/**",
          "sw.js", "manifest.webmanifest", "sitemap.xml", "robots.txt"
        ]
      }
    ],
    "win": { "target": ["nsis", "portable"], "artifactName": "${productName}-Setup-${version}.${ext}" },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true, "createDesktopShortcut": true },
    "mac": { "category": "public.app-category.business", "target": ["dmg", "zip"], "hardenedRuntime": false, "gatekeeperAssess": false },
    "linux": { "target": ["AppImage"], "category": "Office" }
  }
}

<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Calendar — Lines &amp; Logos Business OS</title>
<link rel="icon" type="image/png" href="logo-hero.png">
<link href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;600;700;800&family=Archivo+Black&family=Space+Grotesk:wght@400;500;700&display=swap" rel="stylesheet">
<style>
:root{--ink:#04060d;--navy:#0a1533;--navy-2:#132a63;--blue:#2d5bff;--blue-hi:#4d7dff;--cyan:#57c7ff;--orange:#ff7a1a;--lime:#c6e02c;--yellow:#ffc21c;--green:#3fae5a;--volley:#8fa8ff;--chrome-1:#eef3fc;--line:rgba(120,145,205,.16);--text:#c6d0e6;--text-dim:#7e8cab}
*{margin:0;padding:0;box-sizing:border-box}
body{background:var(--ink);color:var(--text);font-family:'Space Grotesk',system-ui,sans-serif;min-height:100vh}
.chrome{background:linear-gradient(180deg,#fff 0%,#dfe7f5 26%,#8ea2c8 50%,#f4f8ff 60%,#7688ad 86%,#ccd8ee 100%);-webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent}
.topbar{position:sticky;top:0;z-index:50;backdrop-filter:blur(16px);background:rgba(4,6,13,.85);border-bottom:1px solid var(--line);padding:16px 32px;display:flex;align-items:center;gap:18px}
.topbar img{height:44px}
.topbar h1{font-family:'Archivo Black',sans-serif;font-size:18px;text-transform:uppercase}
.topbar .crumb{font-size:12px;color:var(--text-dim);letter-spacing:.12em;text-transform:uppercase;font-weight:600}
.topbar a{margin-left:auto;color:var(--text-dim);text-decoration:none;font-size:13.5px;font-weight:700}
.topbar a:hover{color:#fff}
.btn{font-family:'Archivo',sans-serif;font-weight:800;font-size:13px;color:#fff;border:none;cursor:pointer;padding:11px 20px;border-radius:10px;background:linear-gradient(180deg,#4d7dff,#2d5bff 45%,#1c3fd6);box-shadow:0 0 0 1px rgba(120,160,255,.5) inset;transition:.15s}
.btn:hover{transform:translateY(-1px)}
.btn-ghost{background:transparent;box-shadow:0 0 0 1px var(--line) inset;color:var(--chrome-1)}
main{max-width:1180px;margin:0 auto;padding:36px 28px 90px}
.cal-head{display:flex;align-items:center;gap:18px;margin-bottom:26px}
.cal-head h2{font-family:'Archivo Black',sans-serif;font-size:24px;text-transform:uppercase;min-width:220px;text-align:center}
.nav-btn{width:38px;height:38px;border-radius:11px;border:1px solid var(--line);background:var(--navy);color:#fff;font-size:17px;cursor:pointer;transition:.15s}
.nav-btn:hover{border-color:var(--blue-hi)}
.grid{display:grid;grid-template-columns:repeat(7,1fr);gap:8px}
.dow{font-size:10.5px;letter-spacing:.16em;text-transform:uppercase;color:var(--text-dim);font-weight:700;text-align:center;padding:8px 0}
.day{border:1px solid var(--line);border-radius:14px;min-height:118px;padding:9px;background:rgba(4,6,13,.35);transition:.15s;position:relative}
.day:hover{border-color:rgba(77,125,255,.45)}
.day.blank{border-color:transparent;background:transparent}
.day.today{border-color:var(--blue-hi);box-shadow:0 0 0 1px var(--blue-hi),0 0 24px rgba(45,91,255,.2)}
.day .n{font-size:12px;font-weight:700;color:var(--text-dim);margin-bottom:6px}
.day.today .n{color:#fff}
.ev{font-size:10px;font-weight:700;line-height:1.3;padding:4px 7px;border-radius:6px;margin-bottom:4px;cursor:pointer;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;border-left:2px solid var(--c)}
.ev.order{background:rgba(232,162,74,.12);color:#f2c48a}
.ev.shipping{background:rgba(87,199,255,.1);color:var(--cyan)}
.ev.job{background:rgba(198,224,44,.1);color:var(--lime)}
.ev.walkthrough{background:rgba(143,168,255,.12);color:var(--volley)}
.ev.lead-new,.ev.lead-responded,.ev.quote-sent,.ev.contract-signed{background:rgba(77,125,255,.12);color:var(--blue-hi)}
.ev.contract-signed{color:var(--yellow)}
.legend{display:flex;gap:16px;flex-wrap:wrap;margin-top:22px;font-size:11.5px;font-weight:700}
.legend span{display:flex;align-items:center;gap:7px;color:var(--text-dim)}
.legend i{width:10px;height:10px;border-radius:3px}
/* shipping editor */
.modal-bg{position:fixed;inset:0;background:rgba(2,4,10,.78);backdrop-filter:blur(8px);display:none;align-items:center;justify-content:center;z-index:200;padding:20px}
.modal-bg.open{display:flex}
.modal{width:100%;max-width:460px;border:1px solid var(--line);border-radius:20px;background:linear-gradient(180deg,var(--navy),var(--ink));padding:30px;box-shadow:0 40px 100px rgba(0,0,0,.7)}
.modal h2{font-family:'Archivo Black',sans-serif;font-size:18px;text-transform:uppercase;margin-bottom:4px}
.modal .sub2{font-size:12px;color:var(--text-dim);margin-bottom:18px}
.modal label{display:block;font-size:10.5px;font-weight:700;letter-spacing:.14em;text-transform:uppercase;color:var(--text-dim);margin:0 0 6px}
.modal input,.modal select{width:100%;padding:11px 13px;border-radius:10px;border:1px solid var(--line);background:rgba(4,6,13,.6);color:#fff;font-family:inherit;font-size:13.5px;margin-bottom:13px;outline:none}
.modal input:focus,.modal select:focus{border-color:var(--blue-hi)}
.modal .actions{display:flex;gap:10px}
.toast{position:fixed;bottom:26px;right:26px;background:linear-gradient(180deg,var(--navy-2),var(--navy));border:1px solid rgba(77,125,255,.5);color:#fff;padding:14px 22px;border-radius:13px;font-size:13.5px;font-weight:600;box-shadow:0 20px 50px rgba(0,0,0,.6);transform:translateY(140px);opacity:0;transition:.35s;z-index:300}
.toast.show{transform:none;opacity:1}
@media(max-width:820px){.grid{gap:4px}.day{min-height:74px}.ev{font-size:9px;padding:3px 4px}}
</style>
<link rel="manifest" href="manifest.webmanifest">
<meta name="theme-color" content="#04060d">
<meta name="mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<meta name="apple-mobile-web-app-title" content="Lines & Logos">
<link rel="apple-touch-icon" href="icons/apple-touch-icon.png">
</head>
<body data-perms="notifications">
<header class="topbar">
  <img src="logo-hero.png" alt="Lines &amp; Logos">
  <div><h1 class="chrome">Calendar</h1></div>
  <span class="crumb">Operations / Schedule</span>
  <a href="dashboard.html">← Dashboard</a>
</header>
<main>
  <div class="cal-head">
    <button class="nav-btn" onclick="move(-1)">←</button>
    <h2 class="chrome" id="monthLbl">—</h2>
    <button class="nav-btn" onclick="move(1)">→</button>
    <button class="btn" style="margin-left:auto" onclick="openEvent()">+ Add Event</button>
  </div>
  <div class="grid" id="cal"></div>
  <div class="legend">
    <span><i style="background:#e8a24a"></i>Material orders</span>
    <span><i style="background:#57c7ff"></i>Shipping ETAs (click to update)</span>
    <span><i style="background:#c6e02c"></i>Jobs</span>
    <span><i style="background:#8fa8ff"></i>Walkthroughs</span>
    <span><i style="background:#4d7dff"></i>Lead pipeline events</span>
    <span><i style="background:#ffc21c"></i>Contracts signed</span>
  </div>
</main>

<div class="modal-bg" id="modalBg">
  <div class="modal">
    <h2 class="chrome" id="mTitle">Update shipping</h2>
    <div class="sub2" id="mSub"></div>
    <div id="mFields"></div>
    <div class="actions">
      <button class="btn" onclick="saveModal()">Save</button>
      <button class="btn btn-ghost" onclick="closeModal()">Cancel</button>
    </div>
  </div>
</div>
<div class="toast" id="toast"></div>

<script>
const BASE=(location.protocol==='file:')?'http://localhost:3001':'';
const TOKEN=localStorage.getItem('ll_token');
const COLORS={order:'#e8a24a',shipping:'#57c7ff',job:'#c6e02c',walkthrough:'#8fa8ff','lead-new':'#4d7dff','quote-sent':'#4d7dff','contract-signed':'#ffc21c'};
let now=new Date(); now.setDate(1);
let EVENTS=[];
async function load(){
  const r=await fetch(BASE+'/api/calendar',{headers:{Authorization:'Bearer '+TOKEN}});
  EVENTS=(await r.json())||[];
  render();
}
function render(){
  const y=now.getFullYear(), m=now.getMonth();
  document.getElementById('monthLbl').textContent=now.toLocaleDateString('en-US',{month:'long',year:'numeric'});
  const first=new Date(y,m,1).getDay(), days=new Date(y,m+1,0).getDate();
  let html=['Sun','Mon','Tue','Wed','Thu','Fri','Sat'].map(d=>`<div class="dow">${d}</div>`).join('');
  for(let i=0;i<first;i++) html+='<div class="day blank"></div>';
  const today=new Date().toISOString().slice(0,10);
  for(let d=1;d<=days;d++){
    const ds=`${y}-${String(m+1).padStart(2,'0')}-${String(d).padStart(2,'0')}`;
    const evs=EVENTS.filter(e=>(e.at||'').slice(0,10)===ds);
    html+=`<div class="day ${ds===today?'today':''}"><div class="n">${d}</div>${
      evs.map(e=>`<div class="ev ${e.type}" style="--c:${COLORS[e.type]||'#4d7dff'}" onclick="openEv('${e.id}')" title="${e.title}">${e.title}</div>`).join('')}</div>`;
  }
  document.getElementById('cal').innerHTML=html;
}
function move(n){ now.setMonth(now.getMonth()+n); render(); }
let cur=null, curType='';
function openEv(id){
  const e=EVENTS.find(e=>e.id===id); cur=id; curType=e.type;
  document.getElementById('mTitle').textContent=e.type==='shipping'?'Update shipping':'Edit event';
  document.getElementById('mSub').textContent=e.title;
  const meta=e.meta||{};
  document.getElementById('mFields').innerHTML=`
    <label>Date</label><input id="f-at" type="date" value="${(e.at||'').slice(0,10)}">
    ${e.type==='shipping'?`
      <label>ETA date</label><input id="f-eta" type="date" value="${(meta.eta||'').slice(0,10)}">
      <label>Arrival time</label><input id="f-time" placeholder="10:30 AM" value="${meta.time||''}">
      <label>Carrier</label><input id="f-carrier" placeholder="FedEx Freight" value="${meta.carrier||''}">
      <label>Status</label><select id="f-status">${['processing','in transit','out for delivery','delivered'].map(s=>`<option ${s===meta.status?'selected':''}>${s}</option>`).join('')}</select>`:''}`;
  document.getElementById('modalBg').classList.add('open');
}
function openEvent(){
  cur=null; curType='walkthrough';
  document.getElementById('mTitle').textContent='Add event';
  document.getElementById('mSub').textContent='Manual calendar entry';
  document.getElementById('mFields').innerHTML=`
    <label>Title</label><input id="f-title" placeholder="Walkthrough — Spring Hill HS">
    <label>Date</label><input id="f-at" type="date" value="${new Date().toISOString().slice(0,10)}">
    <label>Type</label><select id="f-type"><option value="walkthrough">Walkthrough</option><option value="job">Job</option><option value="order">Material order</option><option value="lead-new">New lead</option></select>`;
  document.getElementById('modalBg').classList.add('open');
}
function closeModal(){ document.getElementById('modalBg').classList.remove('open'); }
async function saveModal(){
  if(cur){
    const e=EVENTS.find(e=>e.id===cur);
    const patch={ at: document.getElementById('f-at').value };
    if(e.type==='shipping') patch.meta={ ...(e.meta||{}), eta: document.getElementById('f-eta').value, time: document.getElementById('f-time').value, carrier: document.getElementById('f-carrier').value, status: document.getElementById('f-status').value };
    const r=await fetch(BASE+'/api/events/'+cur,{method:'PATCH',headers:{'Content-Type':'application/json',Authorization:'Bearer '+TOKEN},body:JSON.stringify(patch)});
    const upd=await r.json();
    toast(upd.meta&&upd.meta.status==='delivered' ? 'Marked delivered — '+upd.title : 'Updated '+upd.title);
  } else {
    const b={ title: document.getElementById('f-title').value||'Event', at: document.getElementById('f-at').value, type: document.getElementById('f-type').value };
    await fetch(BASE+'/api/events',{method:'POST',headers:{'Content-Type':'application/json',Authorization:'Bearer '+TOKEN},body:JSON.stringify(b)});
    toast('Event added');
  }
  closeModal(); load();
}
function toast(m){const t=document.getElementById('toast');t.textContent=m;t.classList.add('show');setTimeout(()=>t.classList.remove('show'),2600)}
load();
</script>
<script src="assets/pwa.js" defer></script>
<!-- Lines & Logos Business OS -->
</body>
</html>

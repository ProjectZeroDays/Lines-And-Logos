# Lines & Logos Business OS — environment template.
# Copy to .env and fill in what you need — or let the installer / the in-app
# Keys & Integrations page (Admin) write it for you.
# NEVER commit real values — .env is git-ignored.

PORT=3001
NODE_ENV=production

# ---- Stripe (payments, invoicing, tax) ----
# Get both at: https://dashboard.stripe.com/apikeys   (sign up: https://stripe.com)
STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_SECRET_KEY=sk_live_...
# Webhook signing secret: https://dashboard.stripe.com/webhooks
# Add endpoint: <your-domain>/api/stripe/webhook, events:
# checkout.session.completed, invoice.paid, invoice.payment_failed,
# invoice.voided, invoice.marked_uncollectible, credit_note.created
STRIPE_WEBHOOK_SECRET=whsec_...

# ---- AI providers (website chat assistant + agent brains) ----
# OpenRouter — FREE default. Sign up: https://openrouter.ai/  Key: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-...
# Claude — optional, paid. https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...
# ChatGPT — optional, paid. https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...
# Gemini — optional, free tier. https://aistudio.google.com/apikey
GEMINI_API_KEY=AIza...

# ---- Platform ----
# Auto-generated by the installer (any long random string). Protects /api/cron/* if you wire external cron.
CRON_SECRET=

# Local AI model hosting (optional)
LLAMA_HOME=/opt/llama
LLAMA_PORT=11540

# Delivery hygiene
# JWT-less demo auth — set strong demo passwords via admin, keep data/db.json private.

# Deployment
# DOMAIN=linesandlogosteam.com

{
  "name": "lines-and-logos",
  "productName": "Lines & Logos",
  "version": "1.0.0",
  "description": "Lines & Logos Business OS — desktop app (Windows / macOS / Linux)",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win nsis",
    "dist:mac": "electron-builder --mac dmg zip",
    "dist:linux": "electron-builder --linux AppImage deb"
  },
  "build": {
    "appId": "com.linesandlogos.os",
    "productName": "Lines & Logos",
    "files": ["main.js", "preload.js", "icon.png"],
    "win": { "target": ["nsis"], "artifactName": "LinesAndLogos-Setup-${version}.${ext}" },
    "nsis": { "oneClick": false, "perMachine": false, "shortcutName": "Lines & Logos" },
    "mac": { "target": ["dmg", "zip"], "category": "public.app-category.business", "artifactName": "LinesAndLogos-${version}-mac.${ext}" },
    "linux": { "target": ["AppImage", "deb"], "category": "Office", "artifactName": "LinesAndLogos-${version}-linux.${ext}" }
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  }
}
